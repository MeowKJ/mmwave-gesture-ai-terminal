# Stable Meoave product profile. Keep this separate from the audited defaults.
CONFIG_APP_FLS2_OFFICIAL_BASELINE=y
CONFIG_APP_MEOAVE_UI=y
CONFIG_APP_MEOAVE_ESPSR=y
# tools/meoave.py composes this with sdkconfig.hosted.defaults.
# The product's network UI must not be linked to disabled callbacks.
CONFIG_APP_MEOAVE_WIFI_HOSTED=y
