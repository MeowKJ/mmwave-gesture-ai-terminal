# 中控底板 V1.0 / ESP32P4C5（鱼鹰光电 OspreyPi 系列）
# 基础参数沿用 osptek 官方 esp32p4-idf6-co5300 例程
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- USB ----
# 板上唯一 USB 口接在模组 48/49 = USB_DM/DP，即 P4 的 USB 2.0 High-Speed OTG。
# USB-Serial/JTAG 的 GPIO24/25 已被 PA_CTRL 等占用，没有引出，因此
# 应用态由 TinyUSB 提供 CDC（下载/日志）+ HID；console 主通道留在 UART0。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1
# 应用口 VID/PID = 303A:4005，flash_usb.py 靠 VID 找端口、靠 PID 区分 ROM 下载口(0012)
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=y

# ---- LVGL（官方例程同款）----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# ---- 电源键 ----
# 电源键只负责开机（按住 SW1 -> PWR_HOLD 自锁），不做长按动作、不做软件关机。
# 长按 3 s 进 USB 下载模式的兜底由 Kconfig.projbuild 默认关闭，需要时 menuconfig 打开。
