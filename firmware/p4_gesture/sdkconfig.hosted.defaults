# Meoave Hosted-Wi-Fi build profile (OSPTEK ESP32-P4C5).
CONFIG_APP_FLS2_OFFICIAL_BASELINE=y
CONFIG_APP_MEOAVE_UI=y
CONFIG_APP_MEOAVE_WIFI_HOSTED=y

# ESP-IDF remote Wi-Fi API + pinned local ESP-Hosted component.
CONFIG_ESP_WIFI_REMOTE_IN_IDF=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y

# OSPTEK P4C5 internal SDIO mapping; GPIO6 is deliberately absent.
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000

# Do not use optional host wake/power-save GPIO or automatic host restart.
CONFIG_ESP_HOSTED_SLAVE_RESET_ONLY_IF_NECESSARY=y
# CONFIG_ESP_HOSTED_HOST_RESTART_NO_COMMUNICATION_WITH_SLAVE is not set
# CONFIG_ESP_HOSTED_HOST_POWER_SAVE_ENABLED is not set
# CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE is not set
# CONFIG_ESP_HOSTED_WIFI_AUTO_CONNECT_ON_STA_START is not set
# CP GPIO RPC: lets the P4 drive C5 GPIO2 (net shared with P4 GPIO6 /
# ES8389 I2S DOUT) for the audio time-share. Requires the same option on the
# C5 side, whose guard still blocks all six SDIO pins.
CONFIG_ESP_HOSTED_ENABLE_GPIO_EXPANDER=y
# C5 boot from CHIP_PU release to SDIO-slave-ready is slower than 1.5 s on this module.
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=5000
CONFIG_APP_SELFTEST_COLORS=n
CONFIG_APP_AUDIO_BEEP=n
