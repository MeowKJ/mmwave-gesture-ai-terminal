# Product UI and native USB remain available while programming the C5.
CONFIG_APP_C5_SDIO_LOADER=y
# Custom manual-entry SDIO port: no built-in reset/boot GPIO operations.
CONFIG_SERIAL_FLASHER_PORT_UART=n
CONFIG_SERIAL_FLASHER_PORT_SDIO=n
CONFIG_SERIAL_FLASHER_PORT_SPI=n
CONFIG_SERIAL_FLASHER_PORT_USB_CDC_ACM=n
CONFIG_SERIAL_FLASHER_LOG_LEVEL_INFO=y
CONFIG_SERIAL_FLASHER_WRITE_BLOCK_RETRIES=1
