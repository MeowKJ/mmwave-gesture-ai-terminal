{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Meoave - build + tests",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/../../tools/meoave.py", "all"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Meoave - doctor",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/../../tools/meoave.py", "doctor"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "problemMatcher": []
    },
    {
      "label": "Meoave - hosted build",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/../../tools/meoave.py", "build", "--profile", "hosted"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "problemMatcher": []
    },
    {
      "label": "Meoave - native USB hardware test",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/../../tools/meoave.py", "hardware", "--build"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false }
    }
  ]
}
